# SWMS Reports Backend Configuration
# Copy this to .env.local and update with your actual values

# SWMS Reports API Base URL
REPORTS_API_URL=https://your-swms-service-layer.example.com

# SWMS Authentication Headers
SWMS_SITE_ID=YOUR_SITE_ID
SWMS_VERSION=61.0.0
SWMS_USER_ID=YOUR_USER_ID
SWMS_BFF_VERSION=2.1.0
SWMS_FE_VERSION=1.1.4
SWMS_OPCO_NUMBER=your_opco
SWMS_SESSION_USER_ID=OPS$YOUR_USER_ID
SWMS_ORIGIN=https://your-swms-frontend-layer.example.com

# Optional: Session management
SWMS_SESSION_ID=your-session-id-here

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Oracle Database Configuration
ORACLE_USER=your_oracle_username
ORACLE_PASSWORD=your_oracle_password
ORACLE_CONNECTION_STRING=your_oracle_connection_string

# Oracle Database Configuration for SWMS Root Cause Analysis
# These credentials are used to connect to environment-specific Oracle databases

# Development Environment Credentials
ORACLE_DEV_USER=your_dev_oracle_username
ORACLE_DEV_PASSWORD=your_dev_oracle_password

# Production Environment Credentials  
ORACLE_PROD_USER=your_prod_oracle_username
ORACLE_PROD_PASSWORD=your_prod_oracle_password

# Hugging Face Configuration for Single Report Check
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Hugging Face Model to use
HF_MODEL=your_model_here

# Optional: Custom Hugging Face API URL (defaults to inference API)
# HF_API_URL=https://api-inference.huggingface.co/models/your-model